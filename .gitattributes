# Normalize line endings (LF) on commit/checkout for code files
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.p12 binary
*.pfx binary
*.keystore binary

# Code files (explicit LF)
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.webmanifest text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
